# Nintendo Switch Parental Controls Authentication
# The session token is generated during the initial interactive login.
# Run: uv run python scripts/test_nintendo.py
SESSION_TOKEN=

# Optional: ID of the primary Nintendo Switch to manage (if you have multiple).
# If not set, the first detected device is used.
SELECTED_DEVICE_ID=

# Database path (default: data/rewards.db)
DATABASE_PATH=data/rewards.db
